# Copy to .env.local (never commit .env.local). Both integrations are optional.

# Silver Wolf chat powered by Claude. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
# SILVER_WOLF_MODEL=claude-opus-5-5

# HoYoLAB Battle Chronicle sync (read-only, global servers).
# From hoyolab.com while logged in: browser dev tools → Application → Cookies → ltuid_v2 and ltoken_v2.
# These cookies grant access to your HoYoLAB account: keep them private.
HOYOLAB_LTUID_V2=
HOYOLAB_LTOKEN_V2=
