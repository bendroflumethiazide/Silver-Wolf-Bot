{
  "name": "silver-wolf-bot",
  "version": "1.1.2",
  "private": true,
  "description": "Silver Wolf Bot — a local-first Honkai: Star Rail companion with Silver Wolf.",
  "author": "bendroflumethiazide",
  "license": "MIT",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/bendroflumethiazide/Silver-Wolf-Bot.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/prepare-desktop.mjs && playwright test --trace off",
    "desktop:prepare": "next build && node scripts/prepare-desktop.mjs",
    "desktop": "npm run desktop:prepare && electron .",
    "dist:win": "npm run desktop:prepare && electron-builder --win nsis portable --x64",
    "dist:win:portable": "npm run desktop:prepare && electron-builder --win portable zip --x64",
    "dist:linux": "npm run desktop:prepare && electron-builder --linux AppImage --x64",
    "build:web": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "~1.12.0",
    "@mlc-ai/web-llm": "0.2.88",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "~1.78.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.bendroflumethiazide.silverwolfbot",
    "productName": "Silver Wolf Bot",
    "copyright": "MIT · Game content © COGNOSPHERE / HoYoverse",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-desktop",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Silver Wolf Bot",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Silver-Wolf-Bot-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Silver-Wolf-Bot-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "artifactName": "Silver-Wolf-Bot-${version}.${ext}"
    }
  }
}
